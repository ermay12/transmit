{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transmit",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // Renders GET /privacy and GET /terms from docs/launch/privacy-policy.md and terms-of-service.md (and GET /)
  // into src/generated/pages.ts.
  "build": { "command": "node scripts/build-pages.mjs", "watch_dir": ["scripts", "../docs/launch"] },
  // Workers Logs keep only the Worker's own log lines (http.ts log(): no IP addresses, keys, tokens or
  // device IDs), for 3 days. Invocation logs are off: they store every request's headers, including
  // cf-connecting-ip, and its location (city, postal code, coordinates, ASN). Request counts, errors and
  // CPU time stay in the dashboard's Metrics; `wrangler tail` still shows live requests (not stored).
  // Log lines still carry the request's method and URL; query strings are cut from it (the app sends none).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  // The main job every 10 minutes; each run handles what fits in CRON_SUBREQUEST_BUDGET and leaves the rest
  // for the next. The alert job hourly (src/alerts.ts; ALERT_CRON there must match the second entry).
  "triggers": { "crons": ["3,13,23,33,43,53 * * * *", "7 * * * *"] },
  // Per-client (IPv4 address or IPv6 /64) call limits per 60 s, per Cloudflare location; see src/ratelimit.ts.
  // The key is a keyed hash of the network and the UTC day, never the address.
  // namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "TRIAL_RATE_LIMIT", "namespace_id": "461001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SUBSCRIPTION_RATE_LIMIT", "namespace_id": "461002", "simple": { "limit": 30, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transmit",
      "database_id": "fb74b4ce-efa9-4f0a-959d-2c96918ed721",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PACKAGE_NAME": "com.ermay12.transmit",
    // OpenRouter workspace "Transmit Customers"; its default guardrail allows only Gemma 4 31B on ZDR hosts.
    "OPENROUTER_WORKSPACE_ID": "ab9a85f5-3ee7-4578-a4a9-2600970bf7a6",
    // Key names are <prefix>-trial-<id> and <prefix>-sub-<id>.
    "KEY_NAME_PREFIX": "transmit",
    // Free trial: total AI allowance (USD), length, and the cap on new trial allowance per UTC day.
    // The daily cap is off (2026-11-25): 100000 is the most config.ts accepts. Spend is capped by the
    // Transmit Customers workspace's daily budget on OpenRouter instead.
    "TRIAL_ALLOWANCE_USD": "0.50",
    "TRIAL_DAYS": "7",
    "TRIAL_DAILY_BUDGET_USD": "100000",
    // /v1/trial calls one IPv4 address or IPv6 /64 may make per UTC day (each can cost a Play Integrity check;
    // Google allows 10,000 a day).
    "TRIAL_CALLS_PER_IP_PER_DAY": "30",
    // AI allowance per billing period (USD), by "productId" or "productId/basePlanId".
    "PLAN_ALLOWANCES_USD": "{\"transmit_monthly\": 4.50, \"transmit_plus\": 9.00}",
    // Oldest Play Integrity token accepted.
    "INTEGRITY_MAX_AGE_SECONDS": "600",
    // Subrequests (fetches + D1 calls) one scheduled run may use. Each costs ~0.5 ms of CPU and a run gets
    // 10 ms on the Free plan, so keep this near 10 there (the plan's own cap is 50). Minimum 10.
    "CRON_SUBREQUEST_BUDGET": "10",
    // How often the job scans Google's voided purchases (refunds, chargebacks).
    "VOIDED_CHECK_INTERVAL_HOURS": "24",
    // Alert emails (src/alerts.ts), sent through Resend's test sender, which can only email the Resend
    // account's own address. Without the RESEND_API_KEY secret, alerts are only logged.
    "ALERT_EMAIL": "ermay12@gmail.com",
    // Alert when OpenRouter's balance is below this, or the day's spend (UTC) is above this.
    "ALERT_MIN_CREDITS_USD": "25",
    "ALERT_DAILY_SPEND_USD": "70",
    // Alert when today's /v1/trial calls reach this (each can cost one of Google's 10,000 Integrity checks a day).
    "ALERT_INTEGRITY_CHECKS": "7000",
    // The model the Transmit Customers workspace allows; the alert job checks it has a working ZDR host.
    "ALERT_MODEL": "google/gemma-4-31b-it"
  }
}
